# Copy to .env (setup.bat does this) and fill in the 4 REQUIRED values.
# .env is git-ignored. Never paste these values into chat or screenshots.

# ============================ REQUIRED ============================

# 1. Telegram bot token from @BotFather
TELEGRAM_BOT_TOKEN=

# 2. Gemini API key from https://aistudio.google.com/apikey
GEMINI_API_KEY=

# 3. Gemini model name. Use a current model id from Google AI Studio, e.g. gemini-2.5-flash
GEMINI_MODEL=

# 4. Pocket Option session string from a logged-in DEMO account (see README).
#    UNOFFICIAL, read-only market data. Format: 42["auth",{"session":"...","isDemo":1,"uid":...}]
PO_SSID=

# ============================ RECOMMENDED ============================

# Your Telegram user ID(s), comma separated. Only these users can use the app.
# Leave empty at first: send /start to the bot and it tells you your ID if you are not allowed.
ALLOWED_TELEGRAM_USER_IDS=

# ============================ OPTIONAL ============================

APP_NAME=PRISM AI

# HTTPS address of the Mini App. Leave empty to get a free temporary
# https://....trycloudflare.com address automatically (requires cloudflared).
PUBLIC_URL=
PORT=8000

# Seconds between "pair selected" and the UP/DOWN reveal
SIGNAL_COUNTDOWN_SECONDS=20

# Scanner
SCAN_MAX_PAIRS=20
SCAN_MIN_PAYOUT=0
SCAN_INCLUDE_OTC=true
SCAN_INCLUDE_REGULAR=true

# AI
AI_TOP_CANDIDATES=3
AI_CANDLES=128
# Below this model score the signal becomes NO TRADE (0..1)
AI_MIN_CONFIDENCE=0.6

# Market data
PO_REQUIRE_DEMO=true
PO_TIME_OFFSET_SECONDS=auto
PO_STALE_AFTER_SECONDS=10

# Opening http://localhost:8000 in a normal browser (without Telegram). Local testing only.
DEV_ALLOW_BROWSER=false

LOG_LEVEL=INFO
