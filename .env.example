# Copy this file to .env and fill in the values.  .env is git-ignored.
# Never paste these values into chat, screenshots or logs.

# ---------------------------------------------------------------------------
# Market data: Pocket Option (UNOFFICIAL, reverse-engineered, READ-ONLY use)
# ---------------------------------------------------------------------------
# Session string from a logged-in Pocket Option browser tab (see README).
# Format: 42["auth",{"session":"...","isDemo":1,"uid":12345,"platform":2}]
# Paste it on one line, unquoted.
PO_SSID=

# Refuse to start unless the session belongs to a DEMO account.
# Strongly recommended: the app only reads quotes, it never needs a real account.
PO_REQUIRE_DEMO=true

# Pocket Option timestamps may be shifted from UTC by a fixed number of seconds.
# "auto" = detect from the first live ticks (rounded to 30 min). Or set an integer, e.g. 7200.
PO_TIME_OFFSET_SECONDS=auto

# A pair is considered stale if no tick arrives for this many seconds.
PO_STALE_AFTER_SECONDS=10

# Default asset for the Phase 1 probe.
PO_PROBE_ASSET=EURUSD_otc

# ---------------------------------------------------------------------------
# Used from later phases (can stay empty for Phase 1)
# ---------------------------------------------------------------------------
TELEGRAM_BOT_TOKEN=
GEMINI_API_KEY=
# Set to a current Gemini model name from Google's model list.
GEMINI_MODEL=

LOG_LEVEL=INFO
